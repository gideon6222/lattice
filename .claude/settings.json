{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "studio hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "studio hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "studio hook stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(adb *)",
      "Bash(*adb.exe*)",
      "Bash(*/adb*)",
      "Bash(*& adb *)",
      "Bash(*| adb *)",
      "Bash(*; adb *)",
      "Bash(*(adb *)",
      "Bash(*`adb *)",
      "Bash(*\"adb *)",
      "Bash(*'adb *)",
      "Bash(* -c adb *)",
      "Bash(* /c adb *)"
    ]
  }
}
