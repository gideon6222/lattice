{
  "name": "lattice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm run typecheck && npm test && npm run build && npm run size && npm run e2e",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "node tools/check-e2e-browser.mjs && playwright test",
    "size": "node tools/check-bundle-size.mjs",
    "size:update": "node tools/check-bundle-size.mjs --update",
    "film": "node tools/filmstrip.mjs",
    "econ": "node tools/econ.mjs",
    "secrets": "node tools/secrets-probe.mjs",
    "store": "npm run build && node tools/store.mjs"
  },
  "dependencies": {
    "three": "0.166.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.166.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
